# Quadlet unit for Valkey on the native rootless `podman` venue (issue #430, docs/podman.md): the same component
# deploy/docker-compose.yml's `valkey` service and `pi-dispatch up`'s docker path start, for a host that runs jobs
# under this account's own rootless Podman instead of a docker daemon.
#
# Installed by `pi-dispatch service install` (user scope, with podman in PI_BACKENDS) and by `pi-dispatch up`, which
# copy it into ~/.config/containers/systemd/ unchanged but for a VALKEY_URL port other than 6379, with the password
# file it reads beside it. Podman's systemd generator turns it into
# pi-dispatch-valkey.service. Never `systemctl --user enable` it: a generated unit refuses that ("transient or
# generated"); the [Install] section below is read by the generator itself, which links it into default.target
# (measured on Podman 5.8.1: with linger on it came up 25 s after a reboot with nobody logged in).
#
# Fully qualified image names throughout: under short-name enforcement a unit cannot answer the prompt a short
# name raises, so `valkey/valkey:8` could fail to start where Docker quietly assumed docker.io.

[Unit]
Description=pi-dispatch Valkey (the job queue; rootless Podman, Quadlet)

[Container]
Image=docker.io/valkey/valkey:8
ContainerName=pi-dispatch-valkey
# EXPLICIT, see pi-dispatch-valkey.network for why a container here must never rely on the default network.
Network=pi-dispatch-valkey.network
# Bound to localhost only, as in the compose file: the queue is not a public surface. The worker reaches it at
# redis://127.0.0.1:6379, the default VALKEY_URL.
PublishPort=127.0.0.1:6379:6379
# The same named volume `pi-dispatch up` creates on docker, so the wait-list survives a restart and a reboot.
Volume=pi-dispatch-valkey-data:/data
# The password (issue #468): VALKEY_PASSWORD from a 0600 file `service install` and `up` write from the deployment's
# .env, into the container's ENVIRONMENT. Never `--requirepass` on a command line: the image's PID 1 is tini, which keeps
# its whole argv for the life of the container, and any account on the host reads it in /proc/<pid>/cmdline (measured
# on Podman 5.8.1 and 4.9.3). Quadlet also loads this file into the unit's own environment, where systemd would expand a
# bare $VALKEY_PASSWORD in the command below into the password itself: every $ below is written $$ for that reason.
EnvironmentFile=%h/.config/pi-dispatch/valkey.env
# AOF on: the wait-list must survive a reboot (REQ-QUEUE-BURST-NO-DROP). The password reaches valkey-server as
# configuration on stdin (`valkey-server -`), written by the shell's own echo builtin to a 0600 temp file that is opened
# and deleted before the image's entrypoint runs; with VALKEY_PASSWORD empty it starts with none, as before.
Exec=sh -c 'set -eu; if [ -n "$${VALKEY_PASSWORD:-}" ]; then umask 077; f=$$(mktemp); echo "requirepass $$VALKEY_PASSWORD" >"$$f"; exec 0<"$$f"; rm -f "$$f"; set -- -; else set --; fi; unset VALKEY_PASSWORD; exec docker-entrypoint.sh valkey-server "$$@" --appendonly yes'
# Healthy only when Valkey answers PONG to this deployment's password (valkey-cli reads REDISCLI_AUTH from its
# environment); a bare `valkey-cli ping` exits 0 on NOAUTH too.
HealthCmd=if [ -n "$${VALKEY_PASSWORD:-}" ]; then REDISCLI_AUTH="$$VALKEY_PASSWORD"; export REDISCLI_AUTH; fi; valkey-cli ping | grep -q PONG
HealthInterval=10s
HealthTimeout=3s
HealthRetries=5

[Service]
# The first start pulls the image, which can outlast systemd's default 90 s start timeout on a slow link.
TimeoutStartSec=900
Restart=on-failure

[Install]
WantedBy=default.target
